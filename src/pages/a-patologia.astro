---
import { getCollection, getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const [entry] = await getCollection('divulgacao');
const { Content } = await entry.render();
const config = await getEntry('configuracoes', 'site');
const data = config?.data;
---
<Layout title={entry.data.titulo} backHref="/" backLabel="Voltar para o início">
  <style>
    .promo-hero { width: 100%; max-width: 720px; aspect-ratio: 16/9; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; margin: -6px 0 0; display: flex; align-items: center; justify-content: center; }
    .promo-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .promo-hero-cap { font-family: var(--sans); font-size: 11.5px; font-style: italic; color: var(--ink-soft); margin: 8px 0 24px; }

    .page-h1 { font-family: var(--sans); font-weight: 600; font-size: 28px; margin: 4px 0 16px; }
    .promo-body :global(p) { font-size: 16px; line-height: 1.7; color: var(--ink-soft); max-width: 70ch; margin: 0 0 14px; }
    .promo-body :global(em) { display: block; font-size: 13px; margin-top: 4px; }

    .section-h2 {
      font-family: var(--sans); font-weight: 600; font-size: 18px; margin: 32px 0 16px;
      padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;
    }
    .gallery { display: flex; gap: 22px; flex-wrap: wrap; }
    .g-item { width: 220px; }
    .g-item .ph { width: 100%; aspect-ratio: 1/1; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; }
    .g-item .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-item .cap-title { font-family: var(--sans); font-weight: 600; font-size: 13px; margin: 8px 0 2px; }
    .g-item .cap-desc { font-family: var(--sans); font-size: 12px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
    .empty { font-size: 15px; color: var(--ink-soft); }

    .cta-row { margin-top: 26px; display: flex; gap: 12px; flex-wrap: wrap; }
    .cta { font-family: var(--sans); font-size: 13px; font-weight: 600; color: #fff; background: var(--accent); padding: 10px 18px; text-decoration: none; }
    .cta.ghost { color: var(--accent); background: transparent; border: 1px solid var(--accent); }
  </style>

  {data?.patologia_imagem && (
    <>
      <div class="promo-hero"><img src={data.patologia_imagem} alt={data.patologia_imagem_legenda || 'Imagem ilustrativa da área de Patologia'} /></div>
      {data.patologia_imagem_legenda && <p class="promo-hero-cap">{data.patologia_imagem_legenda}</p>}
    </>
  )}

  <h1 class="page-h1">{entry.data.titulo}</h1>
  <div class="promo-body"><Content /></div>

  <h2 class="section-h2">Nossa estrutura</h2>
  {entry.data.galeria && entry.data.galeria.length > 0 ? (
    <div class="gallery">
      {entry.data.galeria.map((g) => (
        <div class="g-item">
          <div class="ph"><img src={g.arquivo} alt={g.titulo} /></div>
          <p class="cap-title">{g.titulo}</p>
          {g.descricao && <p class="cap-desc">{g.descricao}</p>}
        </div>
      ))}
    </div>
  ) : (
    <p class="empty">Fotos da estrutura em breve.</p>
  )}

  <div class="cta-row">
    <a class="cta" href="/professores/">Conheça os professores</a>
    <a class="cta ghost" href="/topicos/">Ver tópicos</a>
  </div>
</Layout>
