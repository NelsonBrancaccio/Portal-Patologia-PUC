---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const todos = await getCollection('professores');
const ativos = todos.filter((p) => p.data.ativo);
const historicos = todos.filter((p) => !p.data.ativo);

async function renderAll(entries: typeof todos) {
  return Promise.all(
    entries.map(async (p) => {
      const { Content } = await p.render();
      return { p, Content };
    })
  );
}

const ativosR = await renderAll(ativos);
const historicosR = await renderAll(historicos);
---
<Layout title="Professores" backHref="/" backLabel="Voltar para o início">
  <style>
    .page-h1 { font-family: var(--sans); font-weight: 600; font-size: 28px; margin: 4px 0 10px; }
    .page-sub { font-size: 15.5px; color: var(--ink-soft); max-width: 60ch; margin: 0 0 28px; }
    .section-h2 {
      font-family: var(--sans); font-weight: 600; font-size: 18px; margin: 32px 0 16px;
      padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;
    }
    .prof-card { border: 1px solid var(--line); background: #fff; padding: 20px; margin-bottom: 18px; display: flex; gap: 18px; align-items: flex-start; }
    .prof-photo { width: 100px; aspect-ratio: 4/5; flex-shrink: 0; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; }
    .prof-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .prof-info { flex: 1; min-width: 0; }
    .prof-info .name { font-family: var(--sans); font-weight: 600; font-size: 16.5px; margin: 0 0 3px; }
    .prof-info .period { font-family: var(--mono); font-size: 12px; color: var(--ink-soft); margin-bottom: 10px; }
    .prof-info .bio { font-size: 15px; line-height: 1.6; }
    .prof-info .bio :global(p) { margin: 0; }
    .contact-row { margin-top: 12px; display: flex; gap: 16px; flex-wrap: wrap; }
    .contact-row a { font-family: var(--sans); font-size: 13px; color: var(--accent); text-decoration: none; }
    .empty { font-size: 15px; color: var(--ink-soft); }

    .gallery-toggle { margin-top: 14px; }
    .gallery-toggle summary { list-style: none; cursor: pointer; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: var(--accent); }
    .gallery-toggle summary::-webkit-details-marker { display: none; }
    .gallery-toggle summary::before { content: "Galeria de fotos ▾ "; }
    .gallery-toggle[open] summary::before { content: "Galeria de fotos ▴ "; }

    .gallery { display: flex; gap: 18px; flex-wrap: wrap; margin-top: 14px; }
    .g-item { width: 160px; }
    .g-item .ph { width: 100%; aspect-ratio: 1/1; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; }
    .g-item .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-item .cap-title { font-family: var(--sans); font-weight: 600; font-size: 12.5px; margin: 6px 0 2px; }
    .g-item .cap-desc { font-family: var(--sans); font-size: 11.5px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
  </style>

  <h1 class="page-h1">Professores de Patologia</h1>
  <p class="page-sub">Quem já passou pela disciplina de Patologia na PUC-SP Sorocaba — e como falar com quem ainda está na ativa.</p>

  <h2 class="section-h2">Em atividade</h2>
  {ativosR.length === 0 ? (
    <p class="empty">Nenhum professor cadastrado ainda.</p>
  ) : (
    ativosR.map(({ p, Content }) => (
      <div class="prof-card">
        {p.data.foto && (
          <div class="prof-photo"><img src={p.data.foto} alt={p.data.nome} /></div>
        )}
        <div class="prof-info">
          <p class="name">{p.data.nome}</p>
          {p.data.periodo && <p class="period">{p.data.periodo}</p>}
          <div class="bio"><Content /></div>
          <div class="contact-row">
            {p.data.contato_email && <a href={`mailto:${p.data.contato_email}`}>{p.data.contato_email}</a>}
            {p.data.contato_telefone && <span>{p.data.contato_telefone}</span>}
          </div>
          {p.data.galeria && p.data.galeria.length > 0 && (
            <details class="gallery-toggle">
              <summary></summary>
              <div class="gallery">
                {p.data.galeria.map((g) => (
                  <div class="g-item">
                    <div class="ph"><img src={g.arquivo} alt={g.titulo} /></div>
                    <p class="cap-title">{g.titulo}</p>
                    {g.descricao && <p class="cap-desc">{g.descricao}</p>}
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    ))
  )}

  <h2 class="section-h2">Já lecionaram</h2>
  {historicosR.length === 0 ? (
    <p class="empty">Nenhum professor cadastrado ainda.</p>
  ) : (
    historicosR.map(({ p, Content }) => (
      <div class="prof-card">
        {p.data.foto && (
          <div class="prof-photo"><img src={p.data.foto} alt={p.data.nome} /></div>
        )}
        <div class="prof-info">
          <p class="name">{p.data.nome}</p>
          {p.data.periodo && <p class="period">{p.data.periodo}</p>}
          <div class="bio"><Content /></div>
          {p.data.galeria && p.data.galeria.length > 0 && (
            <details class="gallery-toggle">
              <summary></summary>
              <div class="gallery">
                {p.data.galeria.map((g) => (
                  <div class="g-item">
                    <div class="ph"><img src={g.arquivo} alt={g.titulo} /></div>
                    <p class="cap-title">{g.titulo}</p>
                    {g.descricao && <p class="cap-desc">{g.descricao}</p>}
                  </div>
                ))}
              </div>
            </details>
          )}
        </div>
      </div>
    ))
  )}
</Layout>
