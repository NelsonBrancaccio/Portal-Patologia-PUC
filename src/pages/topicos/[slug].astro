---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const topicos = await getCollection('topicos');
  return topicos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---
<Layout title={entry.data.titulo} activeArea={entry.data.area}>
  <style>
    .crumb { font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); margin-bottom: 18px; }
    .crumb a { color: var(--navy); text-decoration: underline; text-decoration-color: var(--line); }
    .topic-title h1 { font-family: var(--serif); font-weight: 700; font-size: 36px; line-height: 1.2; margin: 0 0 16px; }
    .meta-row { display: flex; align-items: center; gap: 14px; padding-bottom: 22px; border-bottom: 1px solid var(--line); margin-bottom: 26px; }
    .tag-pill { font-family: var(--sans); font-size: 12px; font-weight: 600; color: var(--accent); background: var(--accent-soft); padding: 4px 11px; }
    .meta-row .m { font-family: var(--mono); font-size: 12px; color: var(--ink-soft); }
    .toc-card { background: #fff; border: 1px solid var(--line); padding: 20px 24px; margin-bottom: 30px; }
    .toc-card .label { font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-soft); margin-bottom: 12px; }
    .toc-card a { display: block; font-family: var(--sans); font-size: 14.5px; color: var(--alert); text-decoration: none; padding: 5px 0; }
    .topic-content :global(h2) { font-family: var(--sans); font-weight: 600; font-size: 20px; margin: 34px 0 6px; padding-bottom: 10px; border-bottom: 2px solid var(--accent); display: inline-block; }
    .topic-content :global(h3) { font-family: var(--sans); font-weight: 600; font-size: 13.5px; color: var(--ink-soft); margin: 18px 0 8px; }
    .topic-content :global(p) { font-size: 16px; line-height: 1.68; margin: 14px 0; max-width: 68ch; }
    .topic-content :global(ul) { margin: 10px 0; padding-left: 20px; font-size: 15.5px; line-height: 1.7; }
    .topic-content :global(ol) { margin: 10px 0; padding-left: 20px; font-size: 14.5px; line-height: 1.7; color: var(--ink-soft); }
    .topic-content :global(img) { max-width: 100%; display: block; margin: 18px 0; border: 1px solid var(--line); }
    .img-credit { font-family: var(--sans); font-size: 11.5px; color: var(--ink-soft); margin: 8px 0 24px; }
    .topic-content :global(.callout) { border-left: 3px solid var(--alert); background: var(--alert-soft, #F1E1DD); padding: 14px 18px; margin: 14px 0; max-width: 62ch; }
    .topic-content :global(.callout .label) { font-family: var(--sans); font-weight: 600; font-size: 12.5px; color: var(--alert); margin: 0 0 8px; }
    .topic-content :global(.callout ul) { margin: 0; padding-left: 18px; font-size: 14px; line-height: 1.6; }
  </style>

  <div class="crumb"><a href="/">Início</a> › <a href="/">{entry.data.area}</a> › {entry.data.titulo}</div>

  <div class="topic-title"><h1>{entry.data.titulo}</h1></div>
  <div class="meta-row">
    <span class="tag-pill">{entry.data.area}</span>
    <span class="m">Atualizado em {entry.data.atualizado.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' })}</span>
  </div>

  <div class="toc-card">
    <div class="label">NESTA PÁGINA</div>
    <a href="#definição--conceito">Definição / conceito</a>
    <a href="#quadro-clínico">Quadro clínico</a>
    <a href="#diagnóstico">Diagnóstico</a>
    <a href="#relevância-prática">Relevância prática</a>
    <a href="#referências">Referências</a>
  </div>

  {entry.data.imagem_principal && (
    <>
      <figure class="figure hero-fig">
        <img
          src={entry.data.imagem_principal}
          alt={`Ilustração de atlas médico — ${entry.data.titulo} (${entry.data.area}) — Portal Patologia PUC`}
          style="width:100%;height:100%;object-fit:cover;"
        />
      </figure>
      <p class="img-credit">Ilustração — Portal Patologia PUC · {entry.data.titulo}</p>
    </>
  )}

  <div class="topic-content">
    <Content />
  </div>
</Layout>
