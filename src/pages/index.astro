---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const topicos = (await getCollection('topicos')).sort(
  (a, b) => b.data.atualizado.valueOf() - a.data.atualizado.valueOf()
);
---
<Layout title="Início">
  <style>
    .hero h1 { font-family: var(--sans); font-weight: 600; font-size: 32px; line-height: 1.22; letter-spacing: -0.01em; max-width: 15ch; margin: 4px 0 16px; }
    .hero p { font-size: 16px; line-height: 1.6; color: var(--ink-soft); max-width: 48ch; margin: 0 0 24px; }
    .stat-row { display: flex; gap: 40px; margin-bottom: 30px; }
    .stat { font-family: var(--sans); }
    .stat .n { font-size: 24px; font-weight: 600; display: block; }
    .stat .l { font-size: 12px; color: var(--ink-soft); }
    .cover {
      aspect-ratio: 16/4.5; background: var(--accent-soft); border: 1px solid #C9D8D5;
      display: flex; align-items: center; justify-content: center; margin-bottom: 30px;
    }
    .cover figcaption { display: none; }
    .section { padding: 30px 0; border-top: 1px solid var(--line); }
    .section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 18px; }
    .section-head h2 { font-family: var(--sans); font-weight: 600; font-size: 14.5px; margin: 0; }
    .topic-list { list-style: none; margin: 0; padding: 0; }
    .topic-row { display: grid; grid-template-columns: 1fr auto; gap: 16px; padding: 15px 0; border-bottom: 1px solid var(--paper-dim); align-items: center; }
    .topic-row:last-child { border-bottom: none; }
    .topic-main .tag { font-family: var(--sans); font-size: 11.5px; color: var(--accent); font-weight: 600; margin-bottom: 4px; display: block; }
    .topic-main .title { font-size: 17px; font-weight: 600; margin: 0; }
    .topic-main .title a { color: var(--ink); text-decoration: none; }
    .topic-date { font-family: var(--mono); font-size: 12px; color: var(--ink-soft); white-space: nowrap; }
    .empty { font-size: 15px; color: var(--ink-soft); }
  </style>

  <!-- Capa do site — ilustrativa por enquanto. Para trocar por uma foto real,
       coloque o arquivo em public/imagens/capa.jpg e troque este bloco <div class="cover">
       por: <img src="/imagens/capa.jpg" alt="" style="width:100%;aspect-ratio:16/4.5;object-fit:cover;" /> -->
  <div class="cover">
    <svg width="120" height="70" viewBox="0 0 120 70" fill="none">
      <ellipse cx="60" cy="35" rx="52" ry="27" stroke="#2E5C57" stroke-width="1.3"/>
      <circle cx="42" cy="26" r="6" stroke="#2E5C57" stroke-width="1.1"/>
      <circle cx="72" cy="42" r="8" stroke="#2E5C57" stroke-width="1.1"/>
      <circle cx="80" cy="20" r="4" stroke="#2E5C57" stroke-width="1.1"/>
      <circle cx="36" cy="48" r="4.5" stroke="#2E5C57" stroke-width="1.1"/>
    </svg>
  </div>

  <div class="hero">
    <h1>Patologia organizada por sistema</h1>
    <p>Achados macroscópicos, microscópicos e correlação clínica — com imagens ilustrativas e de lâmina, para consulta durante o estudo e a prática do laudo.</p>
    <div class="stat-row">
      <div class="stat"><span class="n">{topicos.length}</span><span class="l">tópicos publicados</span></div>
    </div>
  </div>

  <div class="section">
    <div class="section-head"><h2>Tópicos recentes</h2></div>
    {topicos.length === 0 ? (
      <p class="empty">Nenhum tópico publicado ainda.</p>
    ) : (
      <ul class="topic-list">
        {topicos.map((t) => (
          <li class="topic-row">
            <div class="topic-main">
              <span class="tag">{t.data.area}</span>
              <p class="title"><a href={`/topicos/${t.slug}/`}>{t.data.titulo}</a></p>
            </div>
            <span class="topic-date">{t.data.atualizado.toLocaleDateString('pt-BR')}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
</Layout>
