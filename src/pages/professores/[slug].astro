---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const todos = await getCollection('professores');
  return todos.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;

function firstParagraph(md: string) {
  const blocks = md.split(/\n\s*\n/).map((b) => b.trim()).filter(Boolean);
  const first = blocks[0] || '';
  return first
    .replace(/[#>*_`]/g, '')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .trim();
}

const intro = firstParagraph(entry.body ?? '');
---
<Layout title={entry.data.nome} backHref="/professores/" backLabel="Voltar para Professores">
  <style>
    .crumb { font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); margin-bottom: 4px; }
    .crumb a { color: var(--ink-soft); text-decoration: underline; }

    .detail-top { display: flex; gap: 24px; align-items: flex-start; margin: 14px 0 22px; flex-wrap: wrap; }
    .detail-photo { width: 130px; aspect-ratio: 4/5; background: var(--accent-soft); border: 1px solid #C9D8D5; flex-shrink: 0; overflow: hidden; }
    .detail-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .detail-info .name { font-family: var(--sans); font-weight: 600; font-size: 26px; margin: 0 0 6px; }
    .detail-info .period { font-family: var(--mono); font-size: 12.5px; color: var(--ink-soft); margin-bottom: 10px; }
    .detail-info .contact { display: flex; gap: 14px; flex-wrap: wrap; font-family: var(--sans); font-size: 13.5px; }
    .detail-info .contact a { color: var(--accent); text-decoration: none; }

    .first-p { font-size: 16.5px; line-height: 1.7; color: var(--ink); max-width: 66ch; margin: 0 0 8px; }

    .gallery-toggle { margin-top: 24px; }
    .gallery-toggle summary { list-style: none; cursor: pointer; font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--accent); }
    .gallery-toggle summary::-webkit-details-marker { display: none; }
    .gallery-toggle summary::before { content: "Galeria de fotos ▾ "; }
    .gallery-toggle[open] summary::before { content: "Galeria de fotos ▴ "; }

    .gallery { display: grid; grid-template-columns: 1fr; gap: 18px; margin-top: 14px; }
    .g-item { width: 100%; }
    .g-item .ph { width: 100%; aspect-ratio: 1/1; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; }
    .g-item .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-item .cap-title { font-family: var(--sans); font-weight: 600; font-size: 12.5px; margin: 6px 0 2px; }
    .g-item .cap-desc { font-family: var(--sans); font-size: 11.5px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
    @media (min-width: 600px) and (max-width: 959px) { .gallery { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 960px) { .gallery { display: flex; flex-wrap: wrap; gap: 18px; } .g-item { width: 160px; } }
  </style>

  <div class="crumb"><a href="/professores/">Professores</a> › {entry.data.nome}</div>

  <div class="detail-top">
    <div class="detail-photo">{entry.data.foto && <img src={entry.data.foto} alt={entry.data.nome} />}</div>
    <div class="detail-info">
      <p class="name">{entry.data.nome}</p>
      {entry.data.periodo && <p class="period">{entry.data.periodo}</p>}
      {entry.data.ativo && (
        <div class="contact">
          {entry.data.contato_email && <a href={`mailto:${entry.data.contato_email}`}>{entry.data.contato_email}</a>}
          {entry.data.contato_telefone && <span>{entry.data.contato_telefone}</span>}
        </div>
      )}
    </div>
  </div>

  {intro && <p class="first-p">{intro}</p>}

  {entry.data.galeria && entry.data.galeria.length > 0 && (
    <details class="gallery-toggle">
      <summary></summary>
      <div class="gallery">
        {entry.data.galeria.map((g) => (
          <div class="g-item">
            <div class="ph"><img src={g.arquivo} alt={g.titulo} /></div>
            <p class="cap-title">{g.titulo}</p>
            {g.descricao && <p class="cap-desc">{g.descricao}</p>}
          </div>
        ))}
      </div>
    </details>
  )}
</Layout>
