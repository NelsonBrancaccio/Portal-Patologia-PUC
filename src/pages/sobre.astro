---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const [entry] = await getCollection('institucional');
const { Content } = await entry.render();
---
<Layout title={entry.data.titulo} backHref="/" backLabel="Voltar para o início">
  <style>
    .page-h1 { font-family: var(--sans); font-weight: 600; font-size: 28px; margin: 4px 0 24px; }
    .about-body :global(h2) {
      font-family: var(--sans); font-weight: 600; font-size: 19px; margin: 30px 0 12px;
      padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;
    }
    .about-body :global(p) { font-size: 16px; line-height: 1.7; margin: 14px 0; max-width: 70ch; }
    .about-body :global(hr) { border: none; border-top: 1px solid var(--line); margin: 30px 0 16px; }
    .about-body :global(em) { font-size: 13px; color: var(--ink-soft); }
    .about-body :global(a) { color: var(--accent); }

    .section-h2 {
      font-family: var(--sans); font-weight: 600; font-size: 18px; margin: 32px 0 16px;
      padding-bottom: 8px; border-bottom: 2px solid var(--accent); display: inline-block;
    }
    .gallery { display: grid; grid-template-columns: 1fr; gap: 18px; }
    .g-item { width: 100%; }
    @media (min-width: 600px) and (max-width: 959px) { .gallery { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 960px) { .gallery { display: flex; flex-wrap: wrap; gap: 22px; } .g-item { width: 220px; } }
    .g-item .ph { width: 100%; aspect-ratio: 1/1; background: var(--accent-soft); border: 1px solid #C9D8D5; overflow: hidden; }
    .g-item .ph img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .g-item .cap-title { font-family: var(--sans); font-weight: 600; font-size: 13px; margin: 8px 0 2px; }
    .g-item .cap-desc { font-family: var(--sans); font-size: 12px; color: var(--ink-soft); line-height: 1.5; margin: 0; }
  </style>
  <h1 class="page-h1">{entry.data.titulo}</h1>
  <div class="about-body"><Content /></div>

  {entry.data.galeria && entry.data.galeria.length > 0 && (
    <>
      <h2 class="section-h2">Em imagens</h2>
      <div class="gallery">
        {entry.data.galeria.map((g) => (
          <div class="g-item">
            <div class="ph"><img src={g.arquivo} alt={g.titulo} /></div>
            <p class="cap-title">{g.titulo}</p>
            {g.descricao && <p class="cap-desc">{g.descricao}</p>}
          </div>
        ))}
      </div>
    </>
  )}
</Layout>
