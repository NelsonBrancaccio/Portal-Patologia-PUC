---
import { AREAS } from '../content/config';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  activeArea?: string;
}

const { title, activeArea } = Astro.props;

const topicos = await getCollection('topicos');
const porArea = AREAS.map((area) => ({
  area,
  itens: topicos
    .filter((t) => t.data.area === area)
    .sort((a, b) => a.data.titulo.localeCompare(b.data.titulo, 'pt-BR'))
}));

function stripMarkdown(md: string) {
  return md
    .replace(/<[^>]+>/g, ' ')
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[.*?\]\(.*?\)/g, ' ')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/[#>*_`~-]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();
}

function excerptFrom(intro: string | undefined, body: string) {
  if (intro && intro.trim()) return intro.trim();
  const plain = stripMarkdown(body);
  return plain.length > 200 ? plain.slice(0, 200).trim() + '…' : plain;
}

const searchIndex = topicos.map((t) => ({
  titulo: t.data.titulo,
  area: t.data.area,
  tags: t.data.tags ?? [],
  slug: t.slug,
  atualizado: t.data.atualizado.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' }),
  excerpt: excerptFrom(t.data.intro, t.body ?? ''),
  content: stripMarkdown(t.body ?? '')
}));
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Portal Patologia PUC</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', (user) => {
        if (!user) {
          window.netlifyIdentity.on('login', () => {
            document.location.href = '/admin/';
          });
        }
      });
    }
  </script>
  <style>
    :root{
      --navy: #172233;
      --navy-2: #202D42;
      --gold: #BE9C4C;
      --paper: #FAF8F2;
      --paper-dim: #F1EEE3;
      --ink: #211F1A;
      --ink-soft: #625D50;
      --line: #E2DDCC;
      --accent: #2E5C57;
      --accent-soft: #DEE9E6;
      --alert: #7B2E22;
      --alert-soft: #F1E1DD;
      --serif: "Source Serif 4", Georgia, serif;
      --sans: "IBM Plex Sans", -apple-system, sans-serif;
      --mono: "IBM Plex Mono", monospace;
    }
    * { box-sizing: border-box; }
    body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--serif); }

    .site-header { background: var(--navy); padding: 14px 36px; display: flex; align-items: center; gap: 28px; position: relative; z-index: 40; }
    .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .logo-img { height: 42px; width: auto; flex-shrink: 0; display: block; }
    .brand-text .name { font-family: var(--sans); font-weight: 600; font-size: 16.5px; color: #F3F1E8; line-height: 1.2; }
    .brand-text .sub { font-family: var(--sans); font-size: 11.5px; color: #9CA3AE; margin-top: 1px; }

    .search-wrap { flex: 1; max-width: 420px; }
    .hsearch { width: 100%; font-family: var(--serif); font-size: 13.5px; color: #EDEBE3; background: var(--navy-2); border: 1px solid #33415A; padding: 8px 14px; }
    .hsearch::placeholder { color: #8890A0; }

    .hnav { margin-left: auto; display: flex; gap: 26px; font-family: var(--sans); font-size: 13px; }
    .hnav a { color: #D8CFA6; text-decoration: none; }

    .shell { display: grid; grid-template-columns: 240px 1fr; max-width: 1160px; margin: 0 auto; }
    .sidebar { border-right: 1px solid var(--line); padding: 26px 18px; background: var(--paper-dim); }
    .sidebar .label { font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink-soft); margin-bottom: 12px; padding: 0 4px; }

    .area-block { border-bottom: 1px solid var(--paper); }
    .area-block:last-child { border-bottom: none; }
    .area-block summary {
      list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
      font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink);
      padding: 9px 8px; border-left: 2px solid transparent;
    }
    .area-block summary::-webkit-details-marker { display: none; }
    .area-block summary .chev { color: var(--ink-soft); font-size: 11px; transition: transform 0.15s; }
    .area-block[open] summary .chev { transform: rotate(90deg); }
    .area-block.active summary { color: var(--accent); border-left-color: var(--accent); background: var(--accent-soft); }
    .sub-list { list-style: none; margin: 2px 0 8px; padding: 0 0 0 18px; border-left: 1px solid var(--line); }
    .sub-list li { margin: 0; }
    .sub-list a { display: block; font-family: var(--sans); font-size: 12.5px; color: var(--ink-soft); text-decoration: none; padding: 6px 0 6px 12px; }
    .sub-list li.current a { color: var(--accent); font-weight: 600; }
    .sub-list .empty { font-family: var(--sans); font-size: 12px; color: var(--ink-soft); opacity: 0.7; padding: 6px 0 6px 12px; font-style: italic; }

    .main { padding: 34px 44px 40px; }

    .figure { background: var(--accent-soft); border: 1px solid #C9D8D5; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 26px 16px 16px; margin: 20px 0; }
    .figure figcaption { font-family: var(--sans); font-size: 11.5px; font-style: italic; color: var(--ink-soft); margin-top: 12px; text-align: center; max-width: 46ch; }
    .figure.hero-fig { aspect-ratio: 4/3; padding: 0; overflow: hidden; }
    @media (min-width: 760px) {
      .figure.hero-fig { aspect-ratio: 16/5; }
    }

    .site-footer { padding: 22px 44px 30px; font-family: var(--sans); font-size: 12px; color: var(--ink-soft); display: flex; justify-content: space-between; border-top: 1px solid var(--line); max-width: 1160px; margin: 0 auto; }

    @media (max-width: 760px) {
      .shell { grid-template-columns: 1fr; }
      .sidebar { border-right: none; border-bottom: 1px solid var(--line); }
      .main, .site-footer { padding-left: 22px; padding-right: 22px; }
    }
  </style>
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">
      <img class="logo-img" src="/imagens/logo-pucsp.png" alt="Brasão da PUC-SP" />
      <div class="brand-text">
        <div class="name">Portal Patologia PUC</div>
        <div class="sub">PUC-SP Sorocaba</div>
      </div>
    </a>
    <form class="search-wrap" action="/buscar/" method="get">
      <input name="q" id="site-search" class="hsearch" placeholder="Buscar tópico ou palavra-chave..." autocomplete="off" />
    </form>
    <nav class="hnav">
      <a href="/topicos/">Tópicos</a>
      <a href="/professores/">Professores</a>
      <a href="/sobre/">Sobre</a>
      <a href="/admin/">Para autores</a>
    </nav>
  </header>

  <div class="shell">
    <aside class="sidebar">
      <div class="label">ÁREAS</div>
      {porArea.map(({ area, itens }) => (
        <details class={`area-block ${area === activeArea ? 'active' : ''}`} open={area === activeArea}>
          <summary>
            <span>{area}</span>
            <span class="chev">›</span>
          </summary>
          {itens.length === 0 ? (
            <p class="empty" style="margin:0 0 8px 18px;">Nenhum tópico ainda</p>
          ) : (
            <ul class="sub-list">
              {itens.map((t) => (
                <li class={Astro.url.pathname === `/topicos/${t.slug}/` ? 'current' : ''}>
                  <a href={`/topicos/${t.slug}/`}>{t.data.titulo}</a>
                </li>
              ))}
            </ul>
          )}
        </details>
      ))}
    </aside>

    <main class="main">
      <slot />
    </main>
  </div>

  <footer class="site-footer">
    <span>Portal Patologia PUC — conteúdo de referência educacional, não substitui laudo profissional</span>
    <span>PUC-SP Sorocaba</span>
  </footer>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchIndex)}></script>
</body>
</html>
